<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.core.runtime.preferences">
    <initializer class="com.casla.eclipse.ai.preferences.AiPreferenceInitializer"/>
  </extension>

  <extension point="org.eclipse.ui.preferencePages">
    <page
        id="com.casla.eclipse.ai.preferences"
        name="AI Code Assistant"
        class="com.casla.eclipse.ai.preferences.AiPreferencePage"/>
    <page
        id="com.casla.eclipse.ai.preferences.adaptive"
        name="Adaptive Learning"
        category="com.casla.eclipse.ai.preferences"
        class="com.casla.eclipse.ai.preferences.AdaptiveLearningPreferencePage"/>
  </extension>

  <extension point="org.eclipse.ui.commands">
    <command
        id="com.casla.eclipse.ai.commands.fixSelection"
        name="Fix Selection with AI"
        description="Repair the selected ABAP code (or current line) with AI and preview before applying"/>
  </extension>

  <extension point="org.eclipse.ui.handlers">
    <handler
        commandId="com.casla.eclipse.ai.commands.fixSelection"
        class="com.casla.eclipse.ai.codeaction.AiFixSelectionHandler"/>
  </extension>

  <extension point="org.eclipse.ui.bindings">
    <key
        commandId="com.casla.eclipse.ai.commands.fixSelection"
        schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
        sequence="M1+M3+F"/>
  </extension>

  <extension
      point="org.eclipse.jdt.ui.javaCompletionProposalComputer"
      id="completion"
      name="AI Code Completion">
    <proposalCategory icon="icons/ai.svg"/>
  </extension>

  <extension
      point="org.eclipse.jdt.ui.javaCompletionProposalComputer"
      id="completionComputer"
      name="AI Code Completion">
    <javaCompletionProposalComputer
        class="com.casla.eclipse.ai.completion.AiCompletionProposalComputer"
        categoryId="com.casla.eclipse.ai.completion"
        activate="true"
        requiresUIThread="false"
        needsSortingAfterFiltering="false">
      <partition type="__dftl_partition_content_type"/>
    </javaCompletionProposalComputer>
  </extension>

  <extension point="com.sap.adt.tools.abapsource.ui.clientProposalProvider">
    <clientProposalProvider
        class="com.casla.eclipse.ai.completion.abap.AiAbapProposalsProvider"
        name="AI Code Completion (ABAP)">
    </clientProposalProvider>
  </extension>
</plugin>
