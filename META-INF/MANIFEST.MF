Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Casla AI Code Assistant
Bundle-SymbolicName: com.casla.eclipse.ai;singleton:=true
Bundle-Version: 0.3.0
Bundle-Vendor: Casla Group
Bundle-Activator: com.casla.eclipse.ai.AiPlugin
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.equinox.security,
 org.eclipse.jface,
 org.eclipse.jface.text,
 org.eclipse.ui,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.jdt.core,
 org.eclipse.jdt.ui,
 com.sap.adt.tools.abapsource.ui;resolution:=optional,
 com.sap.adt.util.ui;resolution:=optional
Export-Package: com.casla.eclipse.ai.api
Automatic-Module-Name: com.casla.eclipse.ai
